{
  "manifest_version": 3,
  "name": "Sigvoraa Wallet Shield",
  "version": "1.0.0",
  "description": "Checks Solana wallet transactions against Sigvoraa's rules engine before you sign.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.sigvoraa.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/inject.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
